# 如需添加更多环境变量，请以 VITE_APP_ 开头声明
# 在代码中使用 import.meta.env.VITE_APP_XXX 获取指定变量

VITE_APP_ENV = 'production'

# 微信公众号 AppID（H5）
VITE_APP_MP_APPID =

# HTTPS 公网 API（生产必须 https）
VITE_APP_BASE_API = 'https://your-https-api.example.com'

VITE_APP_MOCK_WX = 'false'

VITE_APP_RESOURCES_URL = 'https://your-oss-or-cos.example.com/'
