# 如需添加更多环境变量，请以 VITE_APP_ 开头声明
# 在代码中使用 import.meta.env.VITE_APP_XXX 获取指定变量

VITE_APP_ENV = 'development'

# 微信公众号 AppID（H5 用）。小程序 AppID 在 src/manifest.json 的 mp-weixin.appid
VITE_APP_MP_APPID =

# 用户端对接 yami-shop-api
VITE_APP_BASE_API = 'http://127.0.0.1:8086'

# 开启后登录页显示「模拟微信登录」
VITE_APP_MOCK_WX = 'true'

# 图片域名
VITE_APP_RESOURCES_URL = 'http://127.0.0.1:8085/mall4j/img/
