# 如需添加更多环境变量，请以 VITE_APP_ 开头声明
# 在代码中使用 import.meta.env.VITE_APP_XXX 获取指定变量

VITE_APP_ENV = 'development'

# 微信公众号 AppID（H5 用，可留空）。小程序 AppID 在 src/manifest.json
VITE_APP_MP_APPID =

# 用户端对接 yami-shop-api
VITE_APP_BASE_API = 'http://127.0.0.1:8086'

VITE_APP_MOCK_WX = 'true'

# 图片域名（本地上传由用户端 API 提供，无需 COS）
VITE_APP_RESOURCES_URL = 'http://127.0.0.1:8086/mall4j/img/'

# 小程序订阅消息模板 ID。留空则结算/支付时不弹授权（推荐本地 mock）
VITE_APP_WX_TMPL_PAY =
VITE_APP_WX_TMPL_SHIP =
