# Local infra only. Copy to `.env` if you want to override compose defaults.
# Do not put production secrets here.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=yami_shops
MYSQL_PORT=3306
REDIS_PORT=6379

# Backend (also overridable in application-*.yml)
MYSQL_HOST=127.0.0.1
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
REDIS_HOST=127.0.0.1
REDIS_DATABASE=0

# Mock WeChat login / pay (true = no real merchant credentials required)
SHOP_MVP_MOCK_WECHAT_LOGIN=true
SHOP_MVP_MOCK_PAY=true
SHOP_MVP_ORDER_AUTO_CLOSE=true
SHOP_MVP_ORDER_AUTO_CLOSE_MINUTES=30
SHOP_MVP_ORDER_AUTO_CONFIRM_DAYS=15

# Real WeChat mini-program / pay placeholders (used only when mock flags are false)
WX_APP_ID=
WX_APP_SECRET=
WX_PAY_MCH_ID=
WX_PAY_API_KEY=
WX_PAY_NOTIFY_URL=https://your-https-api.example.com/notice/pay/wechat

# Mini-program subscribe message template IDs (支付成功 / 发货通知). Leave empty to no-op.
# Not secrets. Sys config keys of the same name override these when non-empty.
WX_SUBSCRIBE_PAY_TEMPLATE_ID=
WX_SUBSCRIBE_SHIP_TEMPLATE_ID=
# developer | trial | formal  (local mock stays developer)
# WX_SUBSCRIBE_MINIPROGRAM_STATE=developer

# Courier tracking (快递100). Leave empty to use mock timelines. Do not commit real keys.
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
# Optional. Official poll API; default is fine.
# KUAIDI100_QUERY_URL=https://poll.kuaidi100.com/poll/query.do
